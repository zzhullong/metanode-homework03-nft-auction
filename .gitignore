# Compiler files
cache/
out/

# Commonly ignored directories
.logs/
.ignore/

# Ignores development broadcast logs
!/broadcast
/broadcast/*/31337/
/broadcast/**/dry-run/
# 只保留每个网络脚本的 run-latest.json，忽略带时间戳的副本与恢复锁文件
/broadcast/**/run-[0-9]*.json
/broadcast/**/*.recovery.lock

# Local anvil deployment artifact (deployments/sepolia.json 需要入库)
/deployments/local.json

# Dotenv file
.env
.env.*
!.env.example

# macOS
.DS_Store
