# RPC endpoint for Sepolia, e.g. https://sepolia.infura.io/v3/<key>
SEPOLIA_RPC_URL=

# Deployer private key (never commit the real value)
PRIVATE_KEY=

# Etherscan API key for contract verification (Etherscan v2 covers Sepolia)
ETHERSCAN_API_KEY=

# Optional: address that receives platform fees, defaults to deployer
FEE_RECIPIENT=
